diff --git a/flake.nix b/flake.nix
new file mode 100644
index 0000000..40b1f34
--- /dev/null
+++ b/flake.nix
@@ -0,0 +1,56 @@
+{
+  inputs = {
+    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
+  };
+
+  outputs =
+    { self, nixpkgs, ... }:
+    let
+      systems = [
+        "x86_64-linux"
+        "aarch64-linux"
+      ];
+      forAllSystems = nixpkgs.lib.genAttrs systems;
+    in
+    {
+      packages = forAllSystems (
+        system:
+        let
+          pkgs = nixpkgs.legacyPackages.${system};
+        in
+        {
+          default = pkgs.rustPlatform.buildRustPackage {
+            pname = "roland";
+            version = "0.1.0";
+            src = ./.;
+            cargoHash = "sha256-CWIlkNi6PSiXLEi1gc3uzIWYpQURQadoMqp+eFvt5Ew=";
+            nativeBuildInputs = [ pkgs.pkg-config ];
+            # Upstream test references a missing config.toml fixture
+#            doCheck = false;
+            buildInputs = [
+              pkgs.libinput
+              pkgs.udev
+            ];
+          };
+        }
+      );
+
+      devShells = forAllSystems (
+        system:
+        let
+          pkgs = nixpkgs.legacyPackages.${system};
+        in
+        {
+          default = pkgs.mkShell {
+            inputsFrom = [ (nixpkgs.lib.getAttr system self.packages).default ];
+            packages = [
+              pkgs.cargo
+              pkgs.rustc
+              pkgs.rust-analyzer
+              pkgs.clippy
+            ];
+          };
+        }
+      );
+    };
+}
